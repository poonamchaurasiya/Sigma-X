
#include <iostream>
using namespace std;

int main() {
    int a = 8;

    cout << "Original number: " << a << endl;
    cout << "Left shift by 1: " << (a << 1) << endl;
    cout << "Left shift by 2: " << (a << 2) << endl;
    cout << "Right shift by 1: " << (a >> 1) << endl;
    cout << "Right shift by 2: " << (a >> 2) << endl;

    return 0;
}

